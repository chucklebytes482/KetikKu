{
  "entities": {
    "UserSyncProfile": {
      "title": "UserSyncProfile",
      "description": "User Google Drive sync configuration and last backup status.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase user UID matching document ID."
        },
        "email": {
          "type": "string",
          "description": "Google account email address."
        },
        "autoSync": {
          "type": "boolean",
          "description": "Whether automatic Google Drive backup is enabled."
        },
        "driveFolderId": {
          "type": "string",
          "description": "Optional Google Drive folder or shortcut ID."
        },
        "driveFolderName": {
          "type": "string",
          "description": "Target Google Drive folder name."
        },
        "lastSyncedAtMillis": {
          "type": "integer",
          "description": "Epoch milliseconds of the last completed sync."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "email",
        "autoSync",
        "driveFolderName",
        "lastSyncedAtMillis",
        "createdAt",
        "updatedAt"
      ]
    },
    "BackupSnapshot": {
      "title": "BackupSnapshot",
      "description": "Keyboard settings and dictionary backup record metadata.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase user UID."
        },
        "deviceName": {
          "type": "string",
          "description": "Device model label that created this snapshot."
        },
        "driveFileId": {
          "type": "string",
          "description": "Optional Google Drive file ID of the settings JSON."
        },
        "settingsJson": {
          "type": "string",
          "description": "Serialized JSON snapshot of keyboard settings."
        },
        "dictionaryCount": {
          "type": "integer",
          "description": "Number of personal dictionary entries backed up."
        },
        "syncSource": {
          "type": "string",
          "enum": ["DRIVE_AND_CLOUD", "CLOUD_ONLY"],
          "description": "Sync channel used for this backup."
        },
        "syncedAtMillis": {
          "type": "integer",
          "description": "Client timestamp in epoch millis when synced."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "deviceName",
        "settingsJson",
        "dictionaryCount",
        "syncSource",
        "syncedAtMillis",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserSyncProfile" },
      "description": "Per-user Google Drive sync configuration document."
    },
    "/users/{userId}/backups/{backupId}": {
      "schema": { "$ref": "#/entities/BackupSnapshot" },
      "description": "User-scoped keyboard settings backup snapshots."
    }
  }
}
