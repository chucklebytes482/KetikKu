rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserSyncProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.email is string && data.email.size() <= 200 &&
             data.autoSync is bool &&
             (!('driveFolderId' in data) || (data.driveFolderId is string && data.driveFolderId.size() <= 128)) &&
             data.driveFolderName is string && data.driveFolderName.size() >= 1 && data.driveFolderName.size() <= 100 &&
             data.lastSyncedAtMillis is int && data.lastSyncedAtMillis >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidBackupSnapshot(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 100 &&
             (!('driveFileId' in data) || (data.driveFileId is string && data.driveFileId.size() <= 128)) &&
             data.settingsJson is string && data.settingsJson.size() >= 2 && data.settingsJson.size() <= 16384 &&
             data.dictionaryCount is int && data.dictionaryCount >= 0 && data.dictionaryCount <= 10000 &&
             data.syncSource is string && data.syncSource in ['DRIVE_AND_CLOUD', 'CLOUD_ONLY'] &&
             data.syncedAtMillis is int && data.syncedAtMillis >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'email', 'autoSync', 'driveFolderName', 'lastSyncedAtMillis', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'autoSync', 'driveFolderId', 'driveFolderName', 'lastSyncedAtMillis', 'createdAt', 'updatedAt']) &&
                       isValidUserSyncProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserSyncProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email', 'autoSync', 'driveFolderId', 'driveFolderName', 'lastSyncedAtMillis', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /backups/{backupId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(backupId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(backupId) &&
                         incoming().keys().hasAll(['userId', 'deviceName', 'settingsJson', 'dictionaryCount', 'syncSource', 'syncedAtMillis', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'deviceName', 'driveFileId', 'settingsJson', 'dictionaryCount', 'syncSource', 'syncedAtMillis', 'createdAt', 'updatedAt']) &&
                         isValidBackupSnapshot(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(backupId) &&
                         isValidBackupSnapshot(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['deviceName', 'driveFileId', 'settingsJson', 'dictionaryCount', 'syncSource', 'syncedAtMillis', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(backupId);
      }
    }
  }
}
